# Credenciais locais do Cloudflare R2 (não versionar).
# Copie para .env.r2.local e preencha com um token limitado ao bucket.
#
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
# Permissões: Object Read & Write no bucket do ambiente (ex.: automatize-products-staging)

PRODUCT_ASSETS_R2_ACCESS_KEY_ID=
PRODUCT_ASSETS_R2_SECRET_ACCESS_KEY=


# Base pública para URLs de mídia no R2 (frontend serve /api/media)
MEDIA_PUBLIC_BASE_URL=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# Vercel AI Gateway — https://vercel.com/ai-gateway
# On Vercel deploys, leave this UNSET so OIDC attributes spend to this project.
# For local / Portless / CI, create a key scoped to this Vercel project
# (dashboard: AI Gateway → Create key → bind to this project) and set it here.
# A team-level key (no projectId) lands spend in "No Project".
# AI_GATEWAY_API_KEY=

# Customer-file audience import journey. Defaults enabled for marketing-enabled
# customers; set false to disable uploads without deleting history or changing
# campaigns and the existing audience library.
# CUSTOMER_AUDIENCE_IMPORTS_ENABLED=false

# Shared with apps/support-agent. Bearer for POST /api/internal/mat-performance-report
MAT_PERFORMANCE_REPORT_SECRET=

# Server-to-server trigger for the creative analysis playground. Prefer a
# frontend-specific value; falls back to CRON_SECRET for shared staging setups.
FRONTEND_CRON_SECRET=
FRONTEND_URL=https://staging.automatizemarketing.com

# Business Portfolio ID that receives partner access from customer assets.
META_AUTOMATIZE_BUSINESS_ID=
META_MARKETING_REDIRECT_URI=
META_MARKETING_USER_CONFIG_ID=
META_MARKETING_BISU_CONFIG_ID=
META_GENERAL_APP_ID=
META_ADMIN_RECONNECT_MODE=user
META_PARTNER_AUTO_GRANT_ENABLED=

# OAuth da Conta Mercado Pago do Expert. O backoffice só lê estados e autoriza
# trocas; nunca retorna access/refresh tokens ao navegador.
MERCADOPAGO_ENVIRONMENT=production
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
# Mantido para o mesmo ambiente lógico do frontend; sem G1 confirmado,
# novas cobranças Split Inicial de Expert permanecem bloqueadas.
# Launch gate: references must point to sanitized records outside this repo,
# using the form external:<id>. Empty/fixture/local values remain NO-GO.
PRODUCT_MP_CONTINGENCY_PAUSE=false
